# Hours of mail to fetch (default 12)
EMAILS_ASSISTANT_SINCE_HOURS=12

# Keychain service prefix (macOS host)
EMAILS_ASSISTANT_KEYCHAIN_SERVICE=emails-assistant

# Mailbox aliases used in code/docs (stable). Real addresses only in this local file.
EMAILS_ASSISTANT_ACCOUNTS=email1,email2
# EMAILS_ASSISTANT_EMAIL1=
# EMAILS_ASSISTANT_EMAIL2=
