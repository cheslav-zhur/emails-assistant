{
  "name": "emails-assistant",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "dev"
  },
  "containerEnv": {
    "TZ": "Asia/Ho_Chi_Minh",
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "mounts": [
    "source=/run/host-services/ssh-auth.sock,target=/ssh-agent,type=bind",
    "source=emails-assistant-uv-cache,target=/home/vscode/.cache/uv,type=volume"
  ],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.cache/uv && uv sync --frozen --inexact --extra app --extra login --extra dev",
  "remoteUser": "vscode"
}
