.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# local session handoffs (visible in Dev Container; not for git)
.handoff/

# os / ide
.DS_Store
.idea/
.vscode/
.cursor/rules/

# morning day files (mail text stays out of git)
digests/

# local mail notes (not for git)
private/

# local worktrees
.worktrees/
